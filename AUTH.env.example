# Copy these values into your existing .env.local; do NOT overwrite that file.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Local development. Use your exact HTTPS origin in production.
AUTH_SITE_URL=http://localhost:3000

# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this SERVER-ONLY; never prefix with NEXT_PUBLIC_.
AUTH_RECOVERY_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
